{
  "name": "n8n-nodes-anytype",
  "version": "1.0.0",
  "description": "n8n community node for the Anytype API",
  "license": "MIT",
  "homepage": "https://github.com/splch/n8n-nodes-anytype",
  "keywords": [
    "n8n-community-node-package",
    "anytype",
    "knowledge-base",
    "notes"
  ],
  "author": {
    "name": "Spencer",
    "email": "spence@duck.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/splch/n8n-nodes-anytype.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "check-drift": "npm run build && node scripts/check-drift.mjs",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/AnytypeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Anytype/Anytype.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
